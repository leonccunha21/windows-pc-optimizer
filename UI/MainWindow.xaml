     <Border Background="{DynamicResource UiColor23C6AA}" CornerRadius="12" Width="48" Height="48" HorizontalAlignment="Left"><TextBlock Text="PC" Foreground="{DynamicResource UiColor102638}" FontSize="{DynamicResource UiFont22}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="PC Optimizer" FontSize="{DynamicResource UiFont23}" FontWeight="Bold" Foreground="White" Margin="0,18,0,5"/>
