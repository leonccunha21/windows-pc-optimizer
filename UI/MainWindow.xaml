    </TabItem>
    <TabItem Header="Relatório">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,20,0,0">
       <Border Style="{StaticResource Card}">
        <StackPanel>
         <TextBlock Text="Entrega de atendimento" FontSize="{DynamicResource UiFont20}" FontWeight="SemiBold"/>
         <TextBlock Text="Identificação opcional e observações incluídas somente no arquivo que você salvar. Bateria, discos e limpeza entram no relatório quando analisados." TextWrapping="Wrap" Foreground="{DynamicResource UiColor526B80}" Margin="0,10,0,18"/>
         <TextBlock Text="Cliente / ordem de serviço"/>
         <TextBox x:Name="Customer" MaxLength="180" AutomationProperties.Name="Cliente ou ordem de serviço"/>
         <TextBlock Text="Sintomas, serviços realizados e recomendações"/>
         <TextBox x:Name="Notes" AcceptsReturn="True" Height="130" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="10000" AutomationProperties.Name="Observações do atendimento"/>
         <Button x:Name="ExportButton" Content="Salvar relatório HTML / imprimir em PDF" HorizontalAlignment="Left" AutomationProperties.Name="Salvar relatório HTML / imprimir em PDF" />
         <TextBlock Text="O HTML pode ser aberto no navegador e impresso em PDF. Nenhum dado é enviado à internet." TextWrapping="Wrap" Foreground="{DynamicResource UiColor526B80}" Margin="0,15,0,0"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Preferências">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,20,0,0">
       <Border Style="{StaticResource Card}">
        <StackPanel>
         <TextBlock Text="Ajustar leitura e acessibilidade" FontSize="{DynamicResource UiFont22}" FontWeight="SemiBold"/>
         <TextBlock Text="As escolhas são locais deste perfil. Nenhum dado de cliente ou diagnóstico é salvo. O Windows mantém as próprias configurações de acessibilidade." TextWrapping="Wrap" Foreground="{DynamicResource UiColor526B80}" Margin="0,12,0,20"/>
         <CheckBox x:Name="PreferenceHighContrast" Content="Modo de alto contraste no programa" AutomationProperties.Name="Ativar contraste elevado no PC Optimizer"/>
         <TextBlock Text="Ampliação dos textos" FontWeight="SemiBold" Margin="0,12,0,0"/>
         <ComboBox x:Name="PreferenceTextScale" Width="245" HorizontalAlignment="Left" AutomationProperties.Name="Escala dos textos do aplicativo">
          <ComboBoxItem Content="100% — padrão" Tag="100"/>
          <ComboBoxItem Content="115% — ampliado" Tag="115"/>
          <ComboBoxItem Content="125% — leitura maior" Tag="125"/>
         </ComboBox>
         <WrapPanel Margin="0,10,0,2">
          <Button x:Name="PreferenceApplyButton" Content="Aplicar e salvar" AutomationProperties.Name="Aplicar e salvar preferências"/>
          <Button x:Name="PreferenceResetButton" Content="Restaurar padrão" Background="{DynamicResource UiColor40566C}" AutomationProperties.Name="Restaurar configurações de leitura padrão"/>
         </WrapPanel>
         <TextBlock x:Name="PreferenceStatus" Text="Apenas configurações de leitura serão armazenadas." Foreground="{DynamicResource UiColor526B80}" TextWrapping="Wrap" Margin="0,5,0,8"/>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Card}">
        <StackPanel>
         <TextBlock Text="Atalhos de navegação" FontSize="{DynamicResource UiFont18}" FontWeight="SemiBold"/>
         <TextBlock Text="Ctrl+1 a Ctrl+7: áreas principais. Ctrl+B: bancada técnica. F5: analisar limpeza. Esc: interromper a operação. Ctrl+E: exportar relatório." Foreground="{DynamicResource UiColor526B80}" TextWrapping="Wrap" Margin="0,10,0,0"/>
         <TextBlock Text="A edição 4.5 melhora a leitura, mas testes manuais com Narrador/NVDA, escalas de DPI variadas e Alto Contraste do Windows ainda são recomendados." Foreground="{DynamicResource UiColor526B80}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
   </TabControl>
   <Grid Grid.Row="2" Margin="0,16,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <ProgressBar x:Name="Progress" Height="4" Foreground="{DynamicResource UiColor117B6D}" Background="{DynamicResource UiColorDCE6EF}"/>
     <TextBlock x:Name="Status" Text="Pronto. Escolha uma análise para começar." Foreground="{DynamicResource UiColor526B80}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <Button x:Name="CancelButton" AutomationProperties.Name="Interromper operação - Escape" Grid.Column="1" Content="Interromper" Background="{DynamicResource UiColor40566C}" Margin="15,0,0,0" IsEnabled="False"/>
   </Grid>
  </Grid>
 </Grid>
</Window>
