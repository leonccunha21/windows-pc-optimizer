<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PC Optimizer | Oficina Pro" Width="1300" Height="860" MinWidth="1090" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F3F6FA" FontFamily="Segoe UI" Foreground="#192C42">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="#117B6D"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#38BDF8"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,18"/><Setter Property="BorderBrush" Value="#E1E8F0"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="BorderBrush" Value="#C7D5E2"/><Setter Property="Margin" Value="0,5,0,14"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="38"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E7EDF3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F7FAFC"/><Setter Property="SelectionMode" Value="Single"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="15,11"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="Foreground" Value="#192C42"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="#E7EDF4" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="TabHeader" ContentSource="Header" HorizontalAlignment="Center" TextElement.Foreground="#526B80"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#13283C"/><Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="White"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#117B6D"/><Setter TargetName="TabSurface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Background="#F3F6FA" TextElement.Foreground="#192C42"><Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#102334"><Grid Margin="22,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><Border Background="#2ADCC2" CornerRadius="12" Width="52" Height="52" HorizontalAlignment="Left"><TextBlock Text="PC" Foreground="#102638" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="PC Optimizer" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,17,0,5"/><TextBlock Text="OFICINA PRO / 4.2" FontSize="11" Foreground="#6AE3D0" FontWeight="SemiBold"/></StackPanel>
   <ScrollViewer Grid.Row="1" Margin="0,32,0,0" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="NAVEGAÇÃO" FontSize="10" Foreground="#87ACC1" Margin="0,0,0,15"/>
    <Button x:Name="NavHome" Content="Visão geral" Background="#008C80" Margin="0,0,0,8" AutomationProperties.Name="Visão geral"/>
    <Button x:Name="NavClean" Content="Limpeza segura" Background="#203B50" Margin="0,0,0,8" AutomationProperties.Name="Limpeza segura"/>
    <Button x:Name="NavDiagnostic" Content="Diagnóstico" Background="#203B50" Margin="0,0,0,8" AutomationProperties.Name="Diagnóstico"/>
    <Button x:Name="NavWorkbench" Content="Bancada técnica" Background="#203B50" Margin="0,0,0,8" AutomationProperties.Name="Bancada técnica"/>
    <Button x:Name="NavTools" Content="Ferramentas Windows" Background="#203B50" Margin="0,0,0,8" AutomationProperties.Name="Ferramentas do Windows"/>
    <Button x:Name="NavReport" Content="Relatório" Background="#203B50" Margin="0,0,0,8" AutomationProperties.Name="Relatório do atendimento"/>
    <Border Background="#1B3B4F" CornerRadius="11" Padding="13" Margin="0,28,0,0"><StackPanel>
     <TextBlock Text="CONTROLE DO TÉCNICO" Foreground="#6AE3D0" FontWeight="Bold" FontSize="11"/>
     <TextBlock Text="Diagnósticos sem alterações. Reparos somente por comando e confirmação." Foreground="#D5E3ED" TextWrapping="Wrap" Margin="0,7,0,0"/>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>
   <StackPanel Grid.Row="2"><TextBlock Text="LOCAL • SEM TELEMETRIA" Foreground="#67DDC6" FontSize="10"/><TextBlock Text="Edição oficina / 4.2" Foreground="#86A6C0" Margin="0,7,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Margin="0,0,0,16" Background="#142C40" Padding="22" CornerRadius="14"><StackPanel>
    <TextBlock Text="Central de manutenção" Foreground="White" FontSize="26" FontWeight="Bold"/>
    <TextBlock Text="Diagnóstico, inventário, limpeza e reparos assistidos em um único espaço." Foreground="#C7DEEC" FontSize="12" Margin="0,7,0,0"/>
   </StackPanel></Border>
   <TabControl x:Name="Pages" Grid.Row="1" BorderThickness="0" Background="Transparent">
    <TabControl.Template><ControlTemplate TargetType="TabControl"><Border Background="{TemplateBinding Background}">
     <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
    </Border></ControlTemplate></TabControl.Template>
    <TabItem Header="Visão geral"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,20,0,0">
     <Border Style="{StaticResource Card}" Background="#E2F3EE"><StackPanel><TextBlock Text="Comece conhecendo o equipamento" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Consulte hardware, bateria, espaço disponível e proteção do Windows." TextWrapping="Wrap" Margin="0,10,0,20"/><WrapPanel><Button x:Name="DiagnoseHome" Content="Verificar equipamento"/><Button x:Name="GoWorkbench" Content="Abrir bancada técnica" Background="#40566C"/></WrapPanel></StackPanel></Border>
     <UniformGrid Columns="2"><Border Style="{StaticResource Card}" Margin="0,0,10,18"><StackPanel><TextBlock Text="ESPAÇO ANALISADO" Foreground="#60758A" FontSize="11"/><TextBlock x:Name="ScanMetric" Text="Ainda não analisado" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock Text="Temporários e caches com mais de 7 dias" Foreground="#60758A" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="10,0,0,18"><StackPanel><TextBlock Text="ÚLTIMA LIMPEZA" Foreground="#60758A" FontSize="11"/><TextBlock x:Name="CleanMetric" Text="0 MB" FontSize="28" FontWeight="SemiBold" Foreground="#117B6D" Margin="0,8,0,5"/><TextBlock Text="Somente exclusões confirmadas" Foreground="#60758A"/></StackPanel></Border></UniformGrid>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Limpeza sem surpresas" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Documentos, Downloads, senhas e histórico do navegador ficam fora da limpeza. Pastas com marcadores de projeto e links de diretório são ignorados. Não há ajuste automático de serviços, memória virtual ou Registro." TextWrapping="Wrap" Foreground="#60758A" LineHeight="23" Margin="0,12,0,18"/><Button x:Name="GoClean" Content="Analisar limpeza" HorizontalAlignment="Left"/></StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Limpeza"><Grid Margin="0,20,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,16"><TextBlock Text="Analise primeiro. Limpe apenas o que escolher." FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Feche os navegadores para incluir caches. Arquivos recentes ou alterados serão preservados." TextWrapping="Wrap" Foreground="#60758A" Margin="0,8,0,12"/><WrapPanel><Button x:Name="ScanButton" Content="1. Analisar arquivos" AutomationProperties.Name="Analisar arquivos temporários - F5"/><Button x:Name="CleanButton" Content="2. Limpar selecionados" AutomationProperties.Name="Limpar arquivos revisados - exige confirmação" IsEnabled="False"/><Button x:Name="DetailsButton" Content="Prévia / resultado" Background="#40566C" IsEnabled="False"/><Button x:Name="SelectAllButton" Content="Selecionar tudo" AutomationProperties.Name="Selecionar todas as categorias" Background="#40566C"/><Button x:Name="SelectNoneButton" Content="Desmarcar tudo" AutomationProperties.Name="Desmarcar todas as categorias" Background="#40566C"/><Button x:Name="ExportResultsButton" Content="Exportar CSV" Background="#40566C" IsEnabled="False" AutomationProperties.Name="Exportar resultados da limpeza para CSV"/></WrapPanel></StackPanel>
     <DataGrid x:Name="Categories" Grid.Row="1" AutomationProperties.Name="Categorias de limpeza"><DataGrid.Columns><DataGridCheckBoxColumn Header="Limpar" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="65"/><DataGridTextColumn Header="Categoria" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Arquivos" Binding="{Binding Count}" Width="80" IsReadOnly="True"/><DataGridTextColumn Header="Espaço" Binding="{Binding Size}" Width="100" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
     <TextBox x:Name="ScanWarnings" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="95" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#FFF5DF"/>
     <TextBlock x:Name="CleanupSummary" Grid.Row="3" Text="A análise não apaga arquivos. A exclusão será confirmada antes de começar." TextWrapping="Wrap" Foreground="#60758A" Margin="0,8,0,10"/>
    </Grid></TabItem>
    <TabItem Header="Diagnóstico"><Grid Margin="0,20,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,18"><Button x:Name="DiagnoseButton" Content="Atualizar diagnóstico"/><TextBlock Text="Consulta sem alterar configurações" VerticalAlignment="Center" Foreground="#60758A"/></WrapPanel><DataGrid x:Name="DiagnosticsGrid" Grid.Row="1" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Área" Binding="{Binding Area}" Width="130"/><DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="190"/><DataGridTextColumn Header="Resultado" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="O status básico do disco não substitui SMART completo. Sensores não disponíveis são indicados, sem notas de saúde inventadas." TextWrapping="Wrap" Foreground="#60758A" Margin="0,16,0,10"/></Grid></TabItem>
    <TabItem Header="Bancada"><Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12"><StackPanel>
      <TextBlock Text="INVENTÁRIO TÉCNICO / SOMENTE LEITURA" Foreground="#008C80" FontSize="11" FontWeight="Bold"/>
      <TextBlock Text="Investigue o Windows" FontSize="21" FontWeight="Bold" Margin="0,7,0,5"/>
      <TextBlock Text="Dados reais do equipamento, consultados sem modificar serviços, programas ou preferências." Foreground="#60758A" TextWrapping="Wrap" Margin="0,0,0,14"/>
      <WrapPanel><Button x:Name="ProcessButton" Content="Processos"/><Button x:Name="StartupButton" Content="Inicialização"/><Button x:Name="SoftwareButton" Content="Programas"/><Button x:Name="NetworkButton" Content="Rede"/><Button x:Name="UpdatesButton" Content="Atualizações"/><Button x:Name="DrivesButton" Content="Discos"/></WrapPanel>
     </StackPanel></Border>
     <Border Grid.Row="1" Style="{StaticResource Card}" Padding="15" Margin="0,0,0,12"><Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,8"><TextBlock Text="RESULTADOS" Foreground="#60758A" FontWeight="Bold"/><TextBlock x:Name="WorkbenchCount" DockPanel.Dock="Right" Text="Escolha uma consulta" Foreground="#008C80"/></DockPanel>
      <DataGrid x:Name="WorkbenchGrid" Grid.Row="1" AutomationProperties.Name="Inventário técnico" IsReadOnly="True"><DataGrid.Columns>
       <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*"/>
       <DataGridTextColumn Header="Informações" Binding="{Binding Detail}" Width="2*"/>
       <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="*"/>
      </DataGrid.Columns></DataGrid></Grid></Border>
     <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,0"><StackPanel>
      <TextBlock Text="VERIFICAÇÃO E REPAROS / ADMINISTRADOR" Foreground="#B36A19" FontWeight="Bold" FontSize="11"/>
      <TextBlock Text="Comandos nativos em console separado" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,12"/>
      <WrapPanel><Button x:Name="SfcVerifyButton" Content="SFC · verificar" Background="#36576D"/><Button x:Name="DismScanButton" Content="DISM · verificar" Background="#36576D"/><Button x:Name="ChkdskScanButton" Content="CHKDSK · scan" Background="#36576D"/><Button x:Name="SfcRepairButton" Content="SFC · reparar" Background="#99621D"/><Button x:Name="DismRepairButton" Content="DISM · reparar" Background="#99621D"/></WrapPanel>
      <TextBlock Text="Para reparar, confirme o backup. Uma confirmação e a janela UAC serão exibidas; nenhum reparo é automático." Foreground="#60758A" TextWrapping="Wrap" Margin="0,11,0,0"/>
     </StackPanel></Border>
    </Grid></TabItem>
    <TabItem Header="Ferramentas"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,20,0,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ferramentas do Windows" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Abra a ferramenta, avalie o equipamento e escolha a ação. Nenhum reparo é iniciado automaticamente." TextWrapping="Wrap" Foreground="#60758A" Margin="0,10,0,20"/><WrapPanel Margin="0,0,0,12"><Button x:Name="StartupTool" Content="Inicialização"/><Button x:Name="AppsTool" Content="Aplicativos instalados"/><Button x:Name="StorageTool" Content="Armazenamento"/></WrapPanel><WrapPanel Margin="0,0,0,12"><Button x:Name="SecurityTool" Content="Segurança do Windows"/><Button x:Name="DiskTool" Content="Otimizar unidades"/><Button x:Name="RestoreTool" Content="Proteção do sistema"/></WrapPanel><WrapPanel><Button x:Name="EventsTool" Content="Visualizador de eventos"/><Button x:Name="TaskTool" Content="Gerenciador de tarefas"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Rotina de bancada" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Antes de reparos: confirme o backup do cliente e registre os sintomas. Para notebooks, confira alimentação e bateria. Preserve logs de eventos para investigar falhas. Use o relatório para registrar o serviço e o que ainda precisa ser verificado." TextWrapping="Wrap" LineHeight="24" Foreground="#60758A" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Relatório"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,20,0,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Entrega de atendimento" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Identificação opcional e observações incluídas somente no arquivo que você salvar." TextWrapping="Wrap" Foreground="#60758A" Margin="0,10,0,20"/><TextBlock Text="Cliente / ordem de serviço"/><TextBox x:Name="Customer" MaxLength="180" AutomationProperties.Name="Cliente ou ordem de serviço"/><TextBlock Text="Sintomas, serviços realizados e recomendações"/><TextBox x:Name="Notes" AcceptsReturn="True" Height="130" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="10000" AutomationProperties.Name="Observações do atendimento"/><Button x:Name="ExportButton" Content="Salvar relatório HTML ou JSON" HorizontalAlignment="Left"/><TextBlock Text="O HTML pode ser aberto no navegador e impresso em PDF. Nenhum dado é enviado à internet." TextWrapping="Wrap" Foreground="#60758A" Margin="0,15,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
   </TabControl>
   <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><ProgressBar x:Name="Progress" Height="4" Foreground="#117B6D" Background="#DCE6EF"/><TextBlock x:Name="Status" Text="Pronto. Escolha uma análise para começar." Foreground="#60758A" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="CancelButton" AutomationProperties.Name="Interromper operação - Escape" Grid.Column="1" Content="Interromper" Background="#40566C" Margin="15,0,0,0" IsEnabled="False"/></Grid>
  </Grid>
 </Grid>
</Window>
