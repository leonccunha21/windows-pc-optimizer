<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PC Optimizer | Central de manutenção" Width="1160" Height="800" MinWidth="960" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#F3F6FA" FontFamily="Segoe UI" Foreground="#192C42">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="#117B6D"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#38BDF8"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,18"/><Setter Property="BorderBrush" Value="#E1E8F0"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="BorderBrush" Value="#C7D5E2"/><Setter Property="Margin" Value="0,5,0,14"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="38"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E7EDF3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F7FAFC"/><Setter Property="SelectionMode" Value="Single"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="15,11"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="Foreground" Value="#526B80"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="#E7EDF4" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#13283C"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#117B6D"/><Setter TargetName="TabSurface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Background="#F3F6FA" TextElement.Foreground="#192C42"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#13283C"><Grid Margin="22,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><Border Background="#23C6AA" CornerRadius="12" Width="48" Height="48" HorizontalAlignment="Left"><TextBlock Text="PC" Foreground="#102638" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="PC Optimizer" FontSize="23" FontWeight="Bold" Foreground="White" Margin="0,18,0,5"/><TextBlock Text="CENTRAL DE MANUTENÇÃO" FontSize="10" Foreground="#86A6C0"/></StackPanel>
   <StackPanel Grid.Row="1" Margin="0,44,0,0"><TextBlock Text="SEU ATENDIMENTO" FontSize="10" Foreground="#86A6C0" Margin="0,0,0,16"/><TextBlock Text="01   Diagnosticar" Foreground="#DDEBF5" Margin="0,0,0,20"/><TextBlock Text="02   Analisar arquivos" Foreground="#DDEBF5" Margin="0,0,0,20"/><TextBlock Text="03   Revisar e limpar" Foreground="#DDEBF5" Margin="0,0,0,20"/><TextBlock Text="04   Entregar relatório" Foreground="#DDEBF5"/><Border Background="#203C50" CornerRadius="10" Padding="14" Margin="0,36,0,0"><TextBlock Text="Você decide o que limpar. A análise não altera o computador." TextWrapping="Wrap" Foreground="#B8D9E4" LineHeight="21"/></Border></StackPanel>
   <StackPanel Grid.Row="2"><TextBlock Text="LOCAL • SEM TELEMETRIA" Foreground="#67DDC6" FontSize="10"/><TextBlock Text="Edição oficina / 4.0" Foreground="#86A6C0" Margin="0,7,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22"><StackPanel><TextBlock Text="Um computador pronto para o próximo passo." FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Manutenção com clareza, controle e resultados verificáveis." Foreground="#60758A" Margin="0,8,0,0"/></StackPanel></Grid>
   <TabControl x:Name="Pages" Grid.Row="1" BorderThickness="0" Background="Transparent">
    <TabItem Header="Visão geral"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,20,0,0">
     <Border Style="{StaticResource Card}" Background="#E2F3EE"><StackPanel><TextBlock Text="Comece conhecendo o equipamento" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Consulte hardware, bateria, espaço disponível e proteção do Windows." TextWrapping="Wrap" Margin="0,10,0,20"/><Button x:Name="DiagnoseHome" Content="Verificar equipamento" HorizontalAlignment="Left"/></StackPanel></Border>
     <UniformGrid Columns="2"><Border Style="{StaticResource Card}" Margin="0,0,10,18"><StackPanel><TextBlock Text="ESPAÇO ANALISADO" Foreground="#60758A" FontSize="11"/><TextBlock x:Name="ScanMetric" Text="Ainda não analisado" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock Text="Temporários e caches com mais de 7 dias" Foreground="#60758A" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="10,0,0,18"><StackPanel><TextBlock Text="ÚLTIMA LIMPEZA" Foreground="#60758A" FontSize="11"/><TextBlock x:Name="CleanMetric" Text="0 MB" FontSize="28" FontWeight="SemiBold" Foreground="#117B6D" Margin="0,8,0,5"/><TextBlock Text="Somente exclusões confirmadas" Foreground="#60758A"/></StackPanel></Border></UniformGrid>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Limpeza sem surpresas" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Documentos, Downloads, senhas e histórico do navegador ficam fora da limpeza. Pastas com marcadores de projeto e links de diretório são ignorados. Não há ajuste automático de serviços, memória virtual ou Registro." TextWrapping="Wrap" Foreground="#60758A" LineHeight="23" Margin="0,12,0,18"/><Button x:Name="GoClean" Content="Analisar limpeza" HorizontalAlignment="Left"/></StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Limpeza"><Grid Margin="0,20,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,16"><TextBlock Text="Analise primeiro. Limpe apenas o que escolher." FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Feche os navegadores para incluir caches. Arquivos recentes ou alterados serão preservados." TextWrapping="Wrap" Foreground="#60758A" Margin="0,8,0,12"/><WrapPanel><Button x:Name="ScanButton" Content="1. Analisar arquivos"/><Button x:Name="CleanButton" Content="2. Limpar selecionados" IsEnabled="False"/><Button x:Name="DetailsButton" Content="Ver arquivos" Background="#40566C" IsEnabled="False"/></WrapPanel></StackPanel>
     <DataGrid x:Name="Categories" Grid.Row="1"><DataGrid.Columns><DataGridCheckBoxColumn Header="Limpar" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="65"/><DataGridTextColumn Header="Categoria" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Arquivos" Binding="{Binding Count}" Width="80" IsReadOnly="True"/><DataGridTextColumn Header="Espaço" Binding="{Binding Size}" Width="100" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
     <TextBox x:Name="ScanWarnings" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="95" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#FFF5DF"/>
     <TextBlock x:Name="CleanupSummary" Grid.Row="3" Text="A análise não apaga arquivos. A exclusão será confirmada antes de começar." TextWrapping="Wrap" Foreground="#60758A" Margin="0,8,0,10"/>
    </Grid></TabItem>
    <TabItem Header="Diagnóstico"><Grid Margin="0,20,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,18"><Button x:Name="DiagnoseButton" Content="Atualizar diagnóstico"/><TextBlock Text="Consulta sem alterar configurações" VerticalAlignment="Center" Foreground="#60758A"/></WrapPanel><DataGrid x:Name="DiagnosticsGrid" Grid.Row="1" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Área" Binding="{Binding Area}" Width="130"/><DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="190"/><DataGridTextColumn Header="Resultado" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="O status básico do disco não substitui SMART completo. Sensores não disponíveis são indicados, sem notas de saúde inventadas." TextWrapping="Wrap" Foreground="#60758A" Margin="0,16,0,10"/></Grid></TabItem>
    <TabItem Header="Ferramentas"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,20,0,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ferramentas do Windows" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Abra a ferramenta, avalie o equipamento e escolha a ação. Nenhum reparo é iniciado automaticamente." TextWrapping="Wrap" Foreground="#60758A" Margin="0,10,0,20"/><WrapPanel Margin="0,0,0,12"><Button x:Name="StartupTool" Content="Inicialização"/><Button x:Name="AppsTool" Content="Aplicativos instalados"/><Button x:Name="StorageTool" Content="Armazenamento"/></WrapPanel><WrapPanel Margin="0,0,0,12"><Button x:Name="SecurityTool" Content="Segurança do Windows"/><Button x:Name="DiskTool" Content="Otimizar unidades"/><Button x:Name="RestoreTool" Content="Proteção do sistema"/></WrapPanel><WrapPanel><Button x:Name="EventsTool" Content="Visualizador de eventos"/><Button x:Name="TaskTool" Content="Gerenciador de tarefas"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Rotina de bancada" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Antes de reparos: confirme o backup do cliente e registre os sintomas. Para notebooks, confira alimentação e bateria. Preserve logs de eventos para investigar falhas. Use o relatório para registrar o serviço e o que ainda precisa ser verificado." TextWrapping="Wrap" LineHeight="24" Foreground="#60758A" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Relatório"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,20,0,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Entrega de atendimento" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Identificação opcional e observações incluídas somente no arquivo que você salvar." TextWrapping="Wrap" Foreground="#60758A" Margin="0,10,0,20"/><TextBlock Text="Cliente / ordem de serviço"/><TextBox x:Name="Customer" MaxLength="180" AutomationProperties.Name="Cliente ou ordem de serviço"/><TextBlock Text="Sintomas, serviços realizados e recomendações"/><TextBox x:Name="Notes" AcceptsReturn="True" Height="130" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="10000" AutomationProperties.Name="Observações do atendimento"/><Button x:Name="ExportButton" Content="Salvar relatório HTML / imprimir em PDF" HorizontalAlignment="Left"/><TextBlock Text="O HTML pode ser aberto no navegador e impresso em PDF. Nenhum dado é enviado à internet." TextWrapping="Wrap" Foreground="#60758A" Margin="0,15,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
   </TabControl>
   <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><ProgressBar x:Name="Progress" Height="4" Foreground="#117B6D" Background="#DCE6EF"/><TextBlock x:Name="Status" Text="Pronto. Escolha uma análise para começar." Foreground="#60758A" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Content="Interromper" Background="#40566C" Margin="15,0,0,0" IsEnabled="False"/></Grid>
  </Grid>
 </Grid>
</Window>
