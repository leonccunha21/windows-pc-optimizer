<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PC Optimizer | Oficina Pro" Width="1120" Height="740" MinWidth="920" MinHeight="560" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" ShowInTaskbar="True" Background="#F3F6FA" FontFamily="Segoe UI" Foreground="#192C42">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="18,11"/>
   <Setter Property="Margin" Value="0,0,10,10"/>
   <Setter Property="Background" Value="#117B6D"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#38BDF8"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="SidebarNavButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#E2EDF5"/>
   <Setter Property="Padding" Value="13,11"/>
   <Setter Property="Margin" Value="0,0,0,7"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="NavigationSurface" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavigationSurface" Property="BorderBrush" Value="#5BD7C4"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavigationSurface" Property="BorderBrush" Value="#F5D579"/><Setter TargetName="NavigationSurface" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="NavigationSurface" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="CornerRadius" Value="14"/>
   <Setter Property="Padding" Value="22"/>
   <Setter Property="Margin" Value="0,0,0,18"/>
   <Setter Property="BorderBrush" Value="#E1E8F0"/>
   <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="10"/>
   <Setter Property="BorderBrush" Value="#C7D5E2"/>
   <Setter Property="Margin" Value="0,5,0,14"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="AutoGenerateColumns" Value="False"/>
   <Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="CanUserDeleteRows" Value="False"/>
   <Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="RowHeight" Value="38"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HorizontalGridLinesBrush" Value="#E7EDF3"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="AlternatingRowBackground" Value="#F7FAFC"/>
   <Setter Property="SelectionMode" Value="Single"/>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Padding" Value="15,11"/>
   <Setter Property="Margin" Value="0,0,5,0"/>
   <Setter Property="Foreground" Value="#192C42"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabItem">
      <Border x:Name="TabSurface" Background="#E7EDF4" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter x:Name="TabHeader" ContentSource="Header" HorizontalAlignment="Center" TextElement.Foreground="#526B80"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#13283C"/><Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="White"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#117B6D"/><Setter TargetName="TabSurface" Property="BorderThickness" Value="2"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid Background="#F3F6FA" TextElement.Foreground="#192C42">
  <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#13283C">
   <Grid Margin="22,30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <Border Background="#23C6AA" CornerRadius="12" Width="48" Height="48" HorizontalAlignment="Left"><TextBlock Text="PC" Foreground="#102638" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="PC Optimizer" FontSize="23" FontWeight="Bold" Foreground="White" Margin="0,18,0,5"/>
     <TextBlock Text="CENTRAL DE MANUTENÇÃO" FontSize="10" Foreground="#86A6C0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,26,0,16" KeyboardNavigation.TabNavigation="Continue">
     <StackPanel>
      <TextBlock Text="NAVEGAÇÃO" FontSize="10" Foreground="#9BB5C7" Margin="0,0,0,14" FontWeight="SemiBold"/>
      <Button x:Name="NavOverview" Style="{StaticResource SidebarNavButton}" Background="#0E887A" Content="Visão geral" ToolTip="Ctrl+1" AutomationProperties.Name="Visão geral" />
      <Button x:Name="NavDiagnose" Style="{StaticResource SidebarNavButton}" Content="Diagnóstico" ToolTip="Ctrl+2" AutomationProperties.Name="Diagnóstico" />
      <Button x:Name="NavHealth" Style="{StaticResource SidebarNavButton}" Content="Saúde e discos" ToolTip="Ctrl+3" AutomationProperties.Name="Saúde e discos" />
      <Button x:Name="NavCleanup" Style="{StaticResource SidebarNavButton}" Content="Limpeza segura" ToolTip="Ctrl+4" AutomationProperties.Name="Limpeza segura" />
      <Button x:Name="NavMaintenance" Style="{StaticResource SidebarNavButton}" Content="Manutenção" ToolTip="Ctrl+5" AutomationProperties.Name="Manutenção" />
      <Button x:Name="NavBench" Style="{StaticResource SidebarNavButton}" Content="Bancada técnica" ToolTip="Ctrl+B" AutomationProperties.Name="Bancada técnica" />
      <Button x:Name="NavReport" Style="{StaticResource SidebarNavButton}" Content="Relatório" ToolTip="Ctrl+6" AutomationProperties.Name="Relatório" />
      <Border Background="#203C50" CornerRadius="10" Padding="13" Margin="0,20,0,0">
       <StackPanel>
        <TextBlock Text="SEGURANÇA EM PRIMEIRO LUGAR" FontSize="10" FontWeight="SemiBold" Foreground="#6DE0D0"/>
        <TextBlock Text="Consultas não alteram o sistema. Exclusões e reparos só ocorrem após confirmação." TextWrapping="Wrap" Foreground="#D2E2EC" LineHeight="20" Margin="0,7,0,0"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2">
     <TextBlock Text="LOCAL • SEM TELEMETRIA" Foreground="#67DDC6" FontSize="10"/>
     <TextBlock Text="Edição oficina / 4.4" Foreground="#86A6C0" Margin="0,7,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="28,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="Oficina Pro  •  Central técnica" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="Tudo organizado: diagnóstico, saúde, limpeza, drivers e bancada." TextWrapping="Wrap" Foreground="#526B80" Margin="0,8,0,0"/>
    </StackPanel>
    <Button x:Name="CloseButton" Grid.Column="1" Content="Fechar" Background="#C0392B" VerticalAlignment="Top" AutomationProperties.Name="Fechar aplicativo"/>
   </Grid>
   <TabControl x:Name="Pages" Grid.Row="1" BorderThickness="0" Background="Transparent" KeyboardNavigation.TabNavigation="Continue">
    <TabItem Header="Visão geral">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,20,0,0">
       <Border Style="{StaticResource Card}" Background="#E2F3EE">
        <StackPanel>
         <TextBlock Text="Comece conhecendo o equipamento" FontSize="22" FontWeight="SemiBold"/>
         <TextBlock Text="Consulte hardware, bateria, discos, drivers e espaço disponível antes de qualquer alteração." TextWrapping="Wrap" Margin="0,10,0,18"/>
         <WrapPanel>
          <Button x:Name="DiagnoseHome" Content="Verificar equipamento" AutomationProperties.Name="Verificar equipamento" />
          <Button x:Name="HealthHome" Content="Saúde e ferramentas" Background="#40566C" AutomationProperties.Name="Saúde e ferramentas" />
         </WrapPanel>
        </StackPanel>
       </Border>
       <UniformGrid Columns="2">
        <Border Style="{StaticResource Card}" Margin="0,0,10,18">
         <StackPanel>
          <TextBlock Text="ESPAÇO ANALISADO" Foreground="#526B80" FontSize="11"/>
          <TextBlock x:Name="ScanMetric" Text="Ainda não analisado" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,5"/>
          <TextBlock Text="Temporários e caches com mais de 7 dias" Foreground="#526B80" TextWrapping="Wrap"/>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="10,0,0,18">
         <StackPanel>
          <TextBlock Text="ÚLTIMA LIMPEZA" Foreground="#526B80" FontSize="11"/>
          <TextBlock x:Name="CleanMetric" Text="0 MB" FontSize="28" FontWeight="SemiBold" Foreground="#117B6D" Margin="0,8,0,5"/>
          <TextBlock Text="Somente exclusões confirmadas" Foreground="#526B80"/>
         </StackPanel>
        </Border>
       </UniformGrid>
       <Border Style="{StaticResource Card}">
        <StackPanel>
         <TextBlock Text="Ferramentas que realmente importam" FontSize="18" FontWeight="SemiBold"/>
         <TextBlock Text="Saúde da bateria e capacidade de projeto, SMART e desgaste dos discos, inventário de drivers, atualizações de driver disponíveis no Windows Update, remoção de aplicativos pré-instalados e ajustes seguros de energia e armazenamento." TextWrapping="Wrap" Foreground="#526B80" LineHeight="23" Margin="0,12,0,18"/>
         <WrapPanel>
          <Button x:Name="GoClean" Content="Analisar limpeza" Background="#40566C" AutomationProperties.Name="Analisar limpeza" />
          <Button x:Name="HealthShortcut" Content="Saúde" Background="#40566C" AutomationProperties.Name="Saúde" />
          <Button x:Name="MaintenanceShortcut" Content="Manutenção" Background="#40566C" AutomationProperties.Name="Manutenção" /><Button x:Name="WorkbenchShortcut" Content="Bancada técnica" Background="#40566C" AutomationProperties.Name="Bancada técnica" />
         </WrapPanel>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Limpeza">
     <Grid Margin="0,20,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,16">
       <TextBlock Text="Analise primeiro. Limpe apenas o que escolher." FontSize="19" FontWeight="SemiBold"/>
       <TextBlock Text="Feche os navegadores para incluir caches. Arquivos recentes ou alterados serão preservados." TextWrapping="Wrap" Foreground="#526B80" Margin="0,8,0,12"/>
       <WrapPanel>
        <Button x:Name="ScanButton" Content="1. Analisar arquivos" AutomationProperties.Name="Analisar arquivos temporários - F5"/>
        <Button x:Name="CleanButton" Content="2. Limpar selecionados" AutomationProperties.Name="Limpar arquivos revisados - exige confirmação" IsEnabled="False"/>
        <Button x:Name="DetailsButton" Content="Prévia / resultado" Background="#40566C" IsEnabled="False" AutomationProperties.Name="Prévia / resultado" />
        <Button x:Name="SelectAllButton" Content="Selecionar tudo" AutomationProperties.Name="Selecionar todas as categorias" Background="#40566C"/>
        <Button x:Name="SelectNoneButton" Content="Desmarcar tudo" AutomationProperties.Name="Desmarcar todas as categorias" Background="#40566C"/><Button x:Name="ExportResultsButton" Content="Exportar CSV" AutomationProperties.Name="Exportar resultado da limpeza em CSV" Background="#40566C" IsEnabled="False"/>
        <Button x:Name="ElevateButton" Content="Abrir como administrador" AutomationProperties.Name="Reabrir o PC Optimizer como administrador" ToolTip="Necessário para categorias de sistema como Temp do Windows, Windows Update e Prefetch." Background="#40566C"/>
       </WrapPanel>
      </StackPanel>
      <DataGrid x:Name="Categories" Grid.Row="1">
       <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Limpar" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
        <DataGridTextColumn Header="Categoria" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
        <DataGridTextColumn Header="Arquivos" Binding="{Binding Count}" Width="80" IsReadOnly="True"/>
        <DataGridTextColumn Header="Espaço" Binding="{Binding Size}" Width="100" IsReadOnly="True"/>
        <DataGridTextColumn Header="Risco" Binding="{Binding Risk}" Width="70" IsReadOnly="True"/>
        <DataGridTextColumn Header="Observação" Binding="{Binding Note}" Width="220" IsReadOnly="True"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBox x:Name="ScanWarnings" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="95" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#FFF5DF"/>
      <TextBlock x:Name="CleanupSummary" Grid.Row="3" Text="A análise não apaga arquivos. A exclusão será confirmada antes de começar." TextWrapping="Wrap" Foreground="#526B80" Margin="0,8,0,10"/>
     </Grid>
    </TabItem>
    <TabItem Header="Diagnóstico">
     <Grid Margin="0,20,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <WrapPanel Margin="0,0,0,18"><Button x:Name="DiagnoseButton" Content="Atualizar diagnóstico" AutomationProperties.Name="Atualizar diagnóstico" /><TextBlock Text="Consulta sem alterar configurações" VerticalAlignment="Center" Foreground="#526B80"/></WrapPanel>
      <DataGrid x:Name="DiagnosticsGrid" Grid.Row="1" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Área" Binding="{Binding Area}" Width="130"/>
        <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="190"/>
        <DataGridTextColumn Header="Resultado" Binding="{Binding Value}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="2" Text="O status básico do disco não substitui SMART completo. Sensores não disponíveis são indicados, sem notas de saúde inventadas." TextWrapping="Wrap" Foreground="#526B80" Margin="0,16,0,10"/>
     </Grid>
    </TabItem>
    <TabItem Header="Saúde">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,20,0,0">
       <Border Style="{StaticResource Card}">
        <StackPanel>
         <TextBlock Text="Bateria e armazenamento" FontSize="20" FontWeight="SemiBold"/>
         <TextBlock Text="A bateria usa o relatório oficial do Windows (powercfg). Os discos usam o status do subsistema de armazenamento e os contadores SMART disponíveis. Leituras não alteram nada." TextWrapping="Wrap" Foreground="#526B80" Margin="0,10,0,16"/>
         <WrapPanel>
          <Button x:Name="HealthAnalyzeButton" Content="Analisar bateria e discos" AutomationProperties.Name="Analisar bateria e discos" />
          <Button x:Name="BatteryReportButton" Content="Salvar relatório de bateria" Background="#40566C" AutomationProperties.Name="Salvar relatório de bateria" />
         </WrapPanel>
         <TextBlock x:Name="BatterySummary" Text="Nenhuma análise executada nesta sessão." TextWrapping="Wrap" Foreground="#526B80"/>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Card}">
        <StackPanel>
         <TextBlock Text="Bateria" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
         <DataGrid x:Name="BatteryGrid" Height="210" IsReadOnly="True">
          <DataGrid.Columns>
           <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="240"/>
           <DataGridTextColumn Header="Resultado" Binding="{Binding Value}" Width="*"/>
          </DataGrid.Columns>
         </DataGrid>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Card}">
        <StackPanel>
         <TextBlock Text="Discos físicos" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
         <DataGrid x:Name="DiskGrid" Height="180" IsReadOnly="True">
          <DataGrid.Columns>
           <DataGridTextColumn Header="Dispositivo" Binding="{Binding Device}" Width="*"/>
           <DataGridTextColumn Header="Mídia" Binding="{Binding Media}" Width="90"/>
           <DataGridTextColumn Header="Saúde" Binding="{Binding Rating}" Width="90"/>
           <DataGridTextColumn Header="Capacidade" Binding="{Binding Size}" Width="100"/>
           <DataGridTextColumn Header="Temperatura" Binding="{Binding Temperature}" Width="100"/>
           <DataGridTextColumn Header="Horas" Binding="{Binding PowerOnHours}" Width="70"/>
           <DataGridTextColumn Header="Desgaste" Binding="{Binding Wear}" Width="80"/>
          </DataGrid.Columns>
         </DataGrid>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Card}">
        <StackPanel>
         <TextBlock Text="Volumes" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
         <DataGrid x:Name="VolumeGrid" Height="150" IsReadOnly="True">
          <DataGrid.Columns>
           <DataGridTextColumn Header="Unidade" Binding="{Binding Letter}" Width="80"/>
           <DataGridTextColumn Header="Rótulo" Binding="{Binding Label}" Width="*"/>
           <DataGridTextColumn Header="Sistema" Binding="{Binding FileSystem}" Width="90"/>
           <DataGridTextColumn Header="Livre" Binding="{Binding Free}" Width="100"/>
           <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="100"/>
           <DataGridTextColumn Header="Saúde" Binding="{Binding Health}" Width="100"/>
          </DataGrid.Columns>
         </DataGrid>
         <TextBlock x:Name="HealthNote" Text="Contadores SMART variam por fabricante e controladora. Ausência de leitura não significa disco saudável." TextWrapping="Wrap" Foreground="#526B80" Margin="0,12,0,0"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Manutenção">
     <TabControl x:Name="MaintenanceTabs" Margin="0,20,0,0" BorderThickness="0" Background="Transparent">
      <TabItem Header="Drivers">
       <Grid Margin="0,16,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel>
         <Button x:Name="DriverScanButton" Content="Listar drivers instalados" AutomationProperties.Name="Listar drivers instalados" />
         <Button x:Name="DriverUpdatesButton" Content="Procurar atualizações de driver" Background="#40566C" AutomationProperties.Name="Procurar atualizações de driver" />
         <Button x:Name="DriverUpdateTool" Content="Abrir Windows Update" AutomationProperties.Name="Abrir Windows Update" />
         <Button x:Name="DeviceManagerTool" Content="Gerenciador de dispositivos" Background="#40566C" AutomationProperties.Name="Gerenciador de dispositivos" />
        </WrapPanel>
        <TextBlock x:Name="DriverSummary" Grid.Row="1" Text="Nenhum inventário carregado. A consulta não instala nada." TextWrapping="Wrap" Foreground="#526B80" Margin="0,4,0,12"/>
        <DataGrid x:Name="DriverGrid" Grid.Row="2" IsReadOnly="True">
         <DataGrid.Columns>
          <DataGridTextColumn Header="Classe" Binding="{Binding Class}" Width="130"/>
          <DataGridTextColumn Header="Dispositivo" Binding="{Binding Device}" Width="*"/>
          <DataGridTextColumn Header="Versão" Binding="{Binding Version}" Width="130"/>
          <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="95"/>
          <DataGridTextColumn Header="Assinado" Binding="{Binding Signed}" Width="80"/>
          <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="110"/>
         </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" Text="Atualizações de driver encontradas no Windows Update" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,8"/>
        <DataGrid x:Name="DriverUpdateGrid" Grid.Row="4" Height="140" IsReadOnly="True">
         <DataGrid.Columns>
          <DataGridTextColumn Header="Atualização" Binding="{Binding Title}" Width="*"/>
          <DataGridTextColumn Header="Fabricante" Binding="{Binding Manufacturer}" Width="160"/>
          <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="200"/>
         </DataGrid.Columns>
        </DataGrid>
       </Grid>
      </TabItem>
      <TabItem Header="Aplicativos">
       <Grid Margin="0,16,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel>
         <Button x:Name="AppxScanButton" Content="Listar aplicativos instalados" AutomationProperties.Name="Listar aplicativos instalados" />
         <Button x:Name="AppxRemoveButton" Content="Remover selecionados" Background="#C0392B" AutomationProperties.Name="Remover selecionados" />
         <CheckBox x:Name="AppxBloatOnly" Content="Mostrar só sugestões" VerticalAlignment="Center" Margin="8,0,0,10"/>
        </WrapPanel>
        <TextBlock x:Name="AppxSummary" Grid.Row="1" Text="A lista mostra aplicativos da Microsoft Store do usuário atual. A remoção é confirmada e pode ser desfeita reinstalando pela Store." TextWrapping="Wrap" Foreground="#526B80" Margin="0,4,0,12"/>
        <DataGrid x:Name="AppxGrid" Grid.Row="2">
         <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="Remover" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
          <DataGridTextColumn Header="Aplicativo" Binding="{Binding Label}" Width="*" IsReadOnly="True"/>
          <DataGridTextColumn Header="Pacote" Binding="{Binding Name}" Width="300" IsReadOnly="True"/>
          <DataGridTextColumn Header="Versão" Binding="{Binding Version}" Width="120" IsReadOnly="True"/>
         </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="AppxNote" Grid.Row="3" Text="Sugestões são apenas indicações. Revise a lista: remover Xbox, Teams ou outros aplicativos pode afetar recursos que você usa." TextWrapping="Wrap" Foreground="#526B80" Margin="0,10,0,0"/>
       </Grid>
      </TabItem>
      <TabItem Header="Otimização">
       <Grid Margin="0,16,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel><Button x:Name="OptimizationRunButton" Content="Aplicar selecionadas" AutomationProperties.Name="Aplicar selecionadas" /></WrapPanel>
        <TextBlock x:Name="OptimizationSummary" Grid.Row="1" Text="Marque apenas o que faz sentido para este equipamento. Toda ação pede confirmação." TextWrapping="Wrap" Foreground="#526B80" Margin="0,4,0,12"/>
        <DataGrid x:Name="OptimizationGrid" Grid.Row="2">
         <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="Aplicar" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
          <DataGridTextColumn Header="Ação" Binding="{Binding Name}" Width="230" IsReadOnly="True"/>
          <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
          <DataGridTextColumn Header="Admin" Binding="{Binding Admin}" Width="70" IsReadOnly="True"/>
         </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="OptimizationNote" Grid.Row="3" Text="Sem elevação, ações que exigem administrador falham com explicação e nada é alterado. Não há automação silenciosa." TextWrapping="Wrap" Foreground="#526B80" Margin="0,10,0,0"/>
       </Grid>
      </TabItem>
      <TabItem Header="Atalhos">
       <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,16,0,0">
         <Border Style="{StaticResource Card}">
          <StackPanel>
           <TextBlock Text="Ferramentas do Windows" FontSize="20" FontWeight="SemiBold"/>
           <TextBlock Text="Abra a ferramenta, avalie o equipamento e escolha a ação. Nenhum reparo é iniciado automaticamente." TextWrapping="Wrap" Foreground="#526B80" Margin="0,10,0,16"/>
           <WrapPanel Margin="0,0,0,4"><Button x:Name="StartupTool" Content="Inicialização" AutomationProperties.Name="Inicialização" /><Button x:Name="AppsTool" Content="Aplicativos instalados" AutomationProperties.Name="Aplicativos instalados" /><Button x:Name="StorageTool" Content="Armazenamento" AutomationProperties.Name="Armazenamento" /></WrapPanel>
           <WrapPanel Margin="0,0,0,4"><Button x:Name="SecurityTool" Content="Segurança do Windows" AutomationProperties.Name="Segurança do Windows" /><Button x:Name="DiskTool" Content="Otimizar unidades" AutomationProperties.Name="Otimizar unidades" /><Button x:Name="RestoreTool" Content="Proteção do sistema" AutomationProperties.Name="Proteção do sistema" /></WrapPanel>
           <WrapPanel Margin="0,0,0,4"><Button x:Name="EventsTool" Content="Visualizador de eventos" AutomationProperties.Name="Visualizador de eventos" /><Button x:Name="TaskTool" Content="Gerenciador de tarefas" AutomationProperties.Name="Gerenciador de tarefas" /><Button x:Name="OptionalFeaturesTool" Content="Recursos opcionais" AutomationProperties.Name="Recursos opcionais" /></WrapPanel>
           <WrapPanel><Button x:Name="WindowsUpdateTool" Content="Windows Update" AutomationProperties.Name="Windows Update" /><Button x:Name="PowerOptionsTool" Content="Opções de energia" AutomationProperties.Name="Opções de energia" /><Button x:Name="SystemInfoTool" Content="Informações do sistema" AutomationProperties.Name="Informações do sistema" /></WrapPanel>
          </StackPanel>
         </Border>
         <Border Style="{StaticResource Card}">
          <StackPanel>
           <TextBlock Text="Rotina de bancada" FontSize="18" FontWeight="SemiBold"/>
           <TextBlock Text="Antes de reparos: confirme o backup do cliente e registre os sintomas. Em notebooks, confira alimentação e bateria. Preserve logs de eventos para investigar falhas. Use o relatório para registrar o serviço e o que ainda precisa ser verificado." TextWrapping="Wrap" LineHeight="24" Foreground="#526B80" Margin="0,12,0,0"/>
          </StackPanel>
         </Border>
        </StackPanel>
       </ScrollViewer>
      </TabItem>
      <TabItem Header="Bancada">
       <TabControl x:Name="WorkbenchTabs" Margin="0,18,0,0" BorderThickness="0" Background="Transparent" KeyboardNavigation.TabNavigation="Continue">
        <TabItem Header="Inventário">
         <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,18,0,0">
        <Border Style="{StaticResource Card}"><StackPanel>
         <TextBlock Text="Inventário técnico" FontSize="20" FontWeight="SemiBold"/>
         <TextBlock Text="Processos, inicialização, aplicativos, interfaces, atualizações e discos. Consultas locais sem alterações." Foreground="#526B80" TextWrapping="Wrap" Margin="0,8,0,14"/>
         <WrapPanel>
          <Button x:Name="InvProcessesButton" Content="Processos" AutomationProperties.Name="Processos" /><Button x:Name="InvStartupButton" Content="Inicialização" AutomationProperties.Name="Inicialização" />
          <Button x:Name="InvSoftwareButton" Content="Programas" AutomationProperties.Name="Programas" /><Button x:Name="InvNetworkButton" Content="Adaptadores" AutomationProperties.Name="Adaptadores" />
          <Button x:Name="InvUpdatesButton" Content="Atualizações" AutomationProperties.Name="Atualizações" /><Button x:Name="InvStorageButton" Content="Unidades" AutomationProperties.Name="Unidades" />
         </WrapPanel>
         <TextBlock x:Name="WorkbenchSummary" Text="Selecione uma consulta." Foreground="#526B80" Margin="0,0,0,9"/>
         <DataGrid x:Name="WorkbenchGrid" Height="220" IsReadOnly="True" AutomationProperties.Name="Inventário técnico">
          <DataGrid.Columns>
           <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*"/>
           <DataGridTextColumn Header="Informações" Binding="{Binding Detail}" Width="2*"/>
           <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="*"/>
          </DataGrid.Columns>
         </DataGrid>
        </StackPanel></Border>
          </StackPanel>
         </ScrollViewer>
        </TabItem>
        <TabItem Header="Rede">
         <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,18,0,0">
        <Border Style="{StaticResource Card}"><StackPanel>
         <TextBlock Text="Rede e conectividade" FontSize="20" FontWeight="SemiBold"/>
         <TextBlock Text="Inventário local não gera tráfego externo; IP, gateway, DNS e perfis ficam ocultos por padrão." Foreground="#526B80" TextWrapping="Wrap" Margin="0,8,0,14"/>
         <WrapPanel><Button x:Name="NetworkSnapshotButton" Content="Consultar rede" AutomationProperties.Name="Consultar rede" /><Button x:Name="NetworkRevealButton" Content="Mostrar endereços locais" Background="#40566C" AutomationProperties.Name="Mostrar endereços locais" /></WrapPanel>
         <TextBlock Text="Teste externo opcional — destino autorizado e porta:" Foreground="#526B80" Margin="0,8,0,5"/>
         <WrapPanel>
          <TextBox x:Name="NetworkTarget" Width="225" MaxLength="253" AutomationProperties.Name="Host ou IP para teste TCP e DNS"/>
          <TextBox x:Name="NetworkPort" Width="68" MaxLength="5" Text="443" AutomationProperties.Name="Porta TCP"/>
          <Button x:Name="NetworkProbeButton" Content="Testar DNS e TCP" Background="#40566C" AutomationProperties.Name="Testar DNS e TCP" />
         </WrapPanel>
         <TextBlock x:Name="NetworkSummary" Text="Sem consulta. Teste externo depende de confirmação." TextWrapping="Wrap" Foreground="#526B80" Margin="0,0,0,10"/>
         <DataGrid x:Name="NetworkGrid" Height="215" IsReadOnly="True" AutomationProperties.Name="Resultados de rede">
          <DataGrid.Columns>
           <DataGridTextColumn Header="Área" Binding="{Binding Area}" Width="120"/>
           <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="155"/>
           <DataGridTextColumn Header="Resultado" Binding="{Binding Value}" Width="*"/>
           <DataGridTextColumn Header="Nível" Binding="{Binding Level}" Width="80"/>
          </DataGrid.Columns>
         </DataGrid>
        </StackPanel></Border>
          </StackPanel>
         </ScrollViewer>
        </TabItem>
        <TabItem Header="Histórico">
         <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,18,0,0">
        <Border Style="{StaticResource Card}"><StackPanel>
         <TextBlock Text="Histórico de falhas do Windows" FontSize="20" FontWeight="SemiBold"/>
         <TextBlock Text="Contagem de alertas WHEA, disco, NTFS, desligamentos, tela azul e serviços. Sem copiar mensagens brutas de eventos." TextWrapping="Wrap" Foreground="#526B80" Margin="0,8,0,13"/>
         <Button x:Name="EventsAnalyzeButton" Content="Analisar os últimos 14 dias" HorizontalAlignment="Left" AutomationProperties.Name="Analisar os últimos 14 dias" />
         <TextBlock x:Name="EventsSummary" Text="Histórico não consultado." TextWrapping="Wrap" Foreground="#526B80" Margin="0,5,0,10"/>
         <DataGrid x:Name="EventsGrid" Height="205" IsReadOnly="True" AutomationProperties.Name="Eventos de falhas agrupados">
          <DataGrid.Columns>
           <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="185"/>
           <DataGridTextColumn Header="Qtde" Binding="{Binding Count}" Width="60"/>
           <DataGridTextColumn Header="Alto" Binding="{Binding HighPriorityCount}" Width="60"/>
           <DataGridTextColumn Header="Última ocorrência" Binding="{Binding LastSeen}" Width="140"/>
           <DataGridTextColumn Header="Orientação" Binding="{Binding Guidance}" Width="*"/>
          </DataGrid.Columns>
         </DataGrid>
        </StackPanel></Border>
          </StackPanel>
         </ScrollViewer>
        </TabItem>
        <TabItem Header="Reparos">
         <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,18,0,0">
        <Border Style="{StaticResource Card}"><StackPanel>
         <TextBlock Text="Verificação e reparos do sistema" FontSize="20" FontWeight="SemiBold"/>
         <TextBlock Text="SFC, DISM e CHKDSK em console separado, com confirmação explícita e elevação do Windows (UAC). Confira backup antes de reparar." TextWrapping="Wrap" Foreground="#526B80" Margin="0,8,0,13"/>
         <WrapPanel>
          <Button x:Name="SfcVerifyButton" Content="SFC verificar" Background="#40566C" AutomationProperties.Name="SFC verificar" />
          <Button x:Name="DismScanButton" Content="DISM verificar" Background="#40566C" AutomationProperties.Name="DISM verificar" />
          <Button x:Name="ChkdskScanButton" Content="CHKDSK analisar" Background="#40566C" AutomationProperties.Name="CHKDSK analisar" />
          <Button x:Name="SfcRepairButton" Content="SFC reparar" Background="#99601E" AutomationProperties.Name="SFC reparar" />
          <Button x:Name="DismRepairButton" Content="DISM reparar" Background="#99601E" AutomationProperties.Name="DISM reparar" />
         </WrapPanel>
         <TextBlock Text="O resultado da execução elevada fica no console e não entra automaticamente no relatório." Foreground="#526B80" TextWrapping="Wrap"/>
        </StackPanel></Border>
          </StackPanel>
         </ScrollViewer>
        </TabItem>
       </TabControl>
      </TabItem>
     </TabControl>
    </TabItem>
    <TabItem Header="Relatório">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,20,0,0">
       <Border Style="{StaticResource Card}">
        <StackPanel>
         <TextBlock Text="Entrega de atendimento" FontSize="20" FontWeight="SemiBold"/>
         <TextBlock Text="Identificação opcional e observações incluídas somente no arquivo que você salvar. Bateria, discos e limpeza entram no relatório quando analisados." TextWrapping="Wrap" Foreground="#526B80" Margin="0,10,0,18"/>
         <TextBlock Text="Cliente / ordem de serviço"/>
         <TextBox x:Name="Customer" MaxLength="180" AutomationProperties.Name="Cliente ou ordem de serviço"/>
         <TextBlock Text="Sintomas, serviços realizados e recomendações"/>
         <TextBox x:Name="Notes" AcceptsReturn="True" Height="130" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="10000" AutomationProperties.Name="Observações do atendimento"/>
         <Button x:Name="ExportButton" Content="Salvar relatório HTML / imprimir em PDF" HorizontalAlignment="Left" AutomationProperties.Name="Salvar relatório HTML / imprimir em PDF" />
         <TextBlock Text="O HTML pode ser aberto no navegador e impresso em PDF. Nenhum dado é enviado à internet." TextWrapping="Wrap" Foreground="#526B80" Margin="0,15,0,0"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
   </TabControl>
   <Grid Grid.Row="2" Margin="0,16,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <ProgressBar x:Name="Progress" Height="4" Foreground="#117B6D" Background="#DCE6EF"/>
     <TextBlock x:Name="Status" Text="Pronto. Escolha uma análise para começar." Foreground="#526B80" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <Button x:Name="CancelButton" AutomationProperties.Name="Interromper operação - Escape" Grid.Column="1" Content="Interromper" Background="#40566C" Margin="15,0,0,0" IsEnabled="False"/>
   </Grid>
  </Grid>
 </Grid>
</Window>
