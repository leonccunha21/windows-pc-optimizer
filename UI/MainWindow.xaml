         <WrapPanel>
          <Button x:Name="DiagnoseHome" Content="Verificar equipamento" AutomationProperties.Name="Verificar equipamento" />
          <Button x:Name="HealthHome" Content="Saúde e ferramentas" Background="{DynamicResource UiColor40566C}" AutomationProperties.Name="Saúde e ferramentas" />
         </WrapPanel>
