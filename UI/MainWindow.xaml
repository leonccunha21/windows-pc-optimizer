          <Button x:Name="MaintenanceShortcut" Content="Manutenção" Background="{DynamicResource UiColor40566C}" AutomationProperties.Name="Manutenção" /><Button x:Name="WorkbenchShortcut" Content="Bancada técnica" Background="{DynamicResource UiColor40566C}" AutomationProperties.Name="Bancada técnica" />
         </WrapPanel>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
         <TextBlock Text="Privacidade, IA e Ajustes do Sistema" FontSize="{DynamicResource UiFont18}" FontWeight="SemiBold"/>
         <TextBlock Text="Controle avançado de telemetria, desativação de IA invasiva (Copilot, Recall, Bing), otimizações para jogos e latência, desativação de MPO e perfis de DNS rápido (Cloudflare, Google)." TextWrapping="Wrap" Foreground="{DynamicResource UiColor526B80}" LineHeight="23" Margin="0,12,0,18"/>
         <WrapPanel>
          <Button x:Name="PrivacyShortcut" Content="Privacidade &amp; IA" Background="{DynamicResource UiColor40566C}" AutomationProperties.Name="Abrir configurações de privacidade e IA" />
          <Button x:Name="TweaksShortcut" Content="Ajustes &amp; Gaming" Background="{DynamicResource UiColor40566C}" AutomationProperties.Name="Abrir ajustes de sistema e gaming" />
         </WrapPanel>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
         <TextBlock Text="Assistente local de otimização" FontSize="{DynamicResource UiFont18}" FontWeight="SemiBold"/>
         <TextBlock Text="O agente roda localmente, sem rede e sem telemetria. Ele lê diagnóstico, saúde, limpeza e aplicativos, recomenda as melhores opções com motivo e prioridade, e nunca aplica nada sem sua confirmação." TextWrapping="Wrap" Foreground="{DynamicResource UiColor526B80}" LineHeight="23" Margin="0,12,0,18"/>
         <WrapPanel>
          <Button x:Name="AgentButton" Content="Recomendar melhores opções" AutomationProperties.Name="Recomendar melhores opções com o assistente local" />
